# Copy to backend/.env and fill in real values for local dev.

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://wasteloop:wasteloop@localhost:5432/wasteloop?schema=public"

# JWT signing secret (demo-grade; rotate for anything beyond a prototype)
JWT_SECRET="change-me-in-real-deployments"
JWT_EXPIRES_IN="7d"

# bcrypt cost factor for password hashing
BCRYPT_SALT_ROUNDS=12

# HTTP server
PORT=4000
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:5173"

# OSRM routing engine base URL.
# Self-hosted (docker-compose, after running infra/osrm/scripts/fetch_and_prepare_osm.sh):
#   OSRM_BASE_URL="http://localhost:5000"
# Public demo server fallback (fine for dev, do NOT use for production/high volume):
OSRM_BASE_URL="https://router.project-osrm.org"

# Bin fill-percent threshold above which a bin is a candidate for route optimization
ROUTE_FILL_THRESHOLD_PERCENT=70

# IANA timezone used to bucket calendar days for streaks and daily analytics
APP_TIMEZONE="Asia/Kolkata"

# Enable the in-process sensor simulator's periodic live-tick loop on server boot
SIMULATION_ENABLED=false
SIMULATION_TICK_INTERVAL_MS=30000
